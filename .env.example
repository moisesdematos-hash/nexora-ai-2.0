# ============================================================
# NEXORA AI 2.0 — Environment Variables Example
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file.

# ============================================================
# DATABASE (Supabase PostgreSQL)
# ============================================================
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# ============================================================
# SUPABASE
# ============================================================
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[ANON_KEY]"
SUPABASE_SERVICE_KEY="[SERVICE_ROLE_KEY]"
SUPABASE_JWT_SECRET="[JWT_SECRET]"

# ============================================================
# API SERVER
# ============================================================
API_PORT=3001
NEXT_PUBLIC_API_URL="http://localhost:3001"
API_URL="http://localhost:3001"

# ============================================================
# REDIS (Upstash)
# ============================================================
REDIS_URL="redis://localhost:6379"
UPSTASH_REDIS_REST_URL="https://[UPSTASH_URL].upstash.io"
UPSTASH_REDIS_REST_TOKEN="[UPSTASH_TOKEN]"

# ============================================================
# AI PROVIDERS
# ============================================================
OPENAI_API_KEY="sk-..."
ANTHROPIC_API_KEY="sk-ant-..."
GOOGLE_AI_API_KEY="AIza..."
REPLICATE_API_KEY="r8_..."

# ============================================================
# STORAGE (Supabase)
# ============================================================
SUPABASE_STORAGE_BUCKET="nexora-assets"

# ============================================================
# PAYMENTS (Stripe)
# ============================================================
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ============================================================
# EMAIL (Resend)
# ============================================================
RESEND_API_KEY="re_..."
EMAIL_FROM="noreply@nexora.ai"

# ============================================================
# APP CONFIG
# ============================================================
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_SECRET="[RANDOM_32_CHAR_SECRET]"

# ============================================================
# RATE LIMITING
# ============================================================
THROTTLE_TTL=60
THROTTLE_LIMIT=100
